{
  "name": "cisco-packet-tracer-learning-library-site",
  "private": true,
  "version": "0.1.0",
  "description": "Static Astro website generated at build time from the canonical labs/, projects/, learning-paths/ and docs/ Markdown and metadata in this repository.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "vitest run",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "verify:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "astro": "7.3.8",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
