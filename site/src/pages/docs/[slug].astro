---
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getRepository, type DocPage } from '../../lib/content/repository';
import { url } from '../../lib/site';

export const getStaticPaths = (() => getRepository().docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }))) satisfies GetStaticPaths;
const { doc } = Astro.props as { doc: DocPage };
---
<ArticleLayout
  title={doc.title}
  description={doc.summary ?? undefined}
  crumbs={[{ label: 'Home', href: url('/') }, { label: 'Reference guides', href: url('/docs/') }, { label: doc.title }]}
  html={doc.doc.html}
  toc={doc.doc.toc}
  sourceUrl={doc.doc.githubUrl}
  sourcePath={doc.doc.sourcePath}
>
  <header slot="header" class="doc-header">
    <h1>{doc.title}</h1>
    <span hidden data-pagefind-filter="type">Guide</span>
  </header>
</ArticleLayout>
<style>
  .doc-header h1 { font-size: var(--fs-2xl); margin-top: var(--sp-3); max-width: 24ch; }
</style>
