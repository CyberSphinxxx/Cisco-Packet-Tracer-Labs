---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getRepository } from '../../lib/content/repository';
import { url } from '../../lib/site';
const repo = getRepository();
// Order: the order the root README's Quick Navigation lists them is not encoded
// in metadata, so docs are shown alphabetically by title.
const docs = [...repo.docs].sort((a, b) => a.title.localeCompare(b.title, 'en'));
---
<BaseLayout title="Reference guides" description="Packet Tracer setup, IOS command cheatsheet, troubleshooting method, lab index, curriculum coverage and licensing." noSearchIndex>
  <div class="wrap page-head">
    <Breadcrumbs items={[{ label: 'Home', href: url('/') }, { label: 'Reference guides' }]} />
    <h1>Reference guides</h1>
    <p class="intro">Setup help, command references and background on how the library is organized.</p>
  </div>
  <div class="wrap">
    <ul class="docs">
      {docs.map((d) => (
        <li>
          <h2><a href={d.route}>{d.title}</a></h2>
          {d.summary && <p>{d.summary}</p>}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
<style>
  .docs { list-style: none; margin: var(--sp-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 1.25rem; }
  .docs li { padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .docs h2 { font-size: var(--fs-md); letter-spacing: -0.02em; }
  .docs h2 a { text-decoration: none; }
  .docs h2 a:hover { text-decoration: underline; }
  .docs p { margin: var(--sp-2) 0 0; color: var(--ink-2); font-size: var(--fs-sm); }
</style>
