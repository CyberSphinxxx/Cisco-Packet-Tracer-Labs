---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroNetwork from '../components/HeroNetwork.astro';
import PatchPanel from '../components/PatchPanel.astro';
import WireSwatch from '../components/WireSwatch.astro';
import { getRepository, labelFromSlug } from '../lib/content/repository';
import { SITE_NAME, difficultyLabel, labById, minutesLabel, simulatorLabel, url, wireFor } from '../lib/site';

const repo = getRepository();
const firstPath = repo.paths[0];
const firstStepLab = firstPath?.steps.find((s) => s.labId);
const firstLab = (firstStepLab && labById(firstStepLab.labId!)) || repo.labs[0];
const capstone = repo.projects[0];
const installGuide = repo.docs.find((d) => d.slug === 'installation');
const gettingStarted = repo.docs.find((d) => d.slug === 'getting-started');
const labCount = repo.labs.length;
const tested = repo.labs.filter((l) => l.simulatorStatus === 'tested_pass').length;
const description = `${labCount} original Cisco Packet Tracer labs${capstone ? ' and a capstone project' : ''} with starter topologies, step-by-step guides, verification checks and solution files.`;
const byId = [...repo.labs].sort((a, b) => a.id.localeCompare(b.id, 'en', { numeric: true }));
const runs = repo.paths.map((p) => ({
  path: p,
  stops: p.steps.filter((s) => s.kind === 'lab' && s.labId).map((s) => labById(s.labId!)!).filter(Boolean),
  labCount: p.steps.filter((s) => s.kind === 'lab').length,
}));
const pathName = (title: string) => title.replace(/ Learning Path$/, '').replace(/ Path$/, '');
// Topics you configure across the labs, in learning order (category names and
// the ubiquitous "Cisco IOS" are already obvious, so they are left out).
const generic = new Set(['cisco-ios', ...repo.categories.map((c) => c.slug)]);
const topics = [...new Set(repo.labs.flatMap((l) => l.topics))].filter((t) => !generic.has(t)).slice(0, 18);
// The hero console replays the opening of the first lab (commands from its guide).
const consoleLines: [string, string][] = [
  ['Switch>', 'enable'],
  ['Switch#', 'configure terminal'],
  ['Switch(config)#', 'hostname S1'],
  ['S1(config)#', 'interface vlan 1'],
  ['S1(config-if)#', 'ip address 192.168.1.5 255.255.255.0'],
  ['S1(config-if)#', 'no shutdown'],
];
---
<BaseLayout title={SITE_NAME} description={description} noSearchIndex>
  <section class="hero-band" aria-labelledby="hero-title">
    <HeroNetwork />
    <div class="hero wrap">
      <div class="hero-copy">
        <h1 id="hero-title"><span>Patch into a lab.</span> <span>Configure it.</span> <span>Prove it works.</span></h1>
        <p class="lead">
          {labCount} original Cisco Packet Tracer labs{capstone && <> and a capstone project</>}, written for students with no networking background.
          Each one gives you a cabled starter topology, a step-by-step walkthrough, verification commands and the finished file to compare against.
        </p>
        <div class="hero-actions">
          {firstPath && <a class="btn btn-go" href={firstPath.route}>Start the {pathName(firstPath.title).toLowerCase()} path</a>}
          <a class="btn" href={url('/labs/')}>Browse all {labCount} labs</a>
        </div>
        {installGuide && (
          <p class="hero-note">
            Packet Tracer is free with a Cisco Networking Academy account. <a href={installGuide.route}>How to install it</a>.
          </p>
        )}
        {topics.length > 0 && (
          <div class="hero-topics">
            <h2 id="topics-title" class="topics-title">Topics you will configure</h2>
            <ul class="topic-list" aria-labelledby="topics-title">
              {topics.map((t) => <li><a href={url(`/labs/?topic=${encodeURIComponent(t)}`)}>{labelFromSlug(t)}</a></li>)}
              <li class="topic-more"><a href={url('/labs/')}>All topics</a></li>
            </ul>
          </div>
        )}
      </div>

      {firstLab && (
        <figure class="hero-console on-steel">
          <div class="console-bar" aria-hidden="true">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="console-title">S1 console</span>
          </div>
          <pre><code>{consoleLines.map(([prompt, cmd], i) => (
            <span class="cl" style={`--i: ${i}`}><span class="ios-prompt">{prompt}</span> {cmd}{'\n'}</span>
          ))}<span class="cl cl-last" style={`--i: ${consoleLines.length}`}><span class="ios-prompt">S1(config-if)#</span> <span class="cursor" aria-hidden="true"></span></span></code></pre>
          <figcaption>Your first commands, from <a href={firstLab.route}>{firstLab.id}: {firstLab.title}</a>.</figcaption>
        </figure>
      )}
    </div>

  </section>

  <section class="wrap panel-section" aria-labelledby="ports-title">
    <PatchPanel startId={firstLab?.id} />
    <ul class="legend" aria-label="What the panel shows">
      {repo.categories.map((c) => (
        <li><WireSwatch category={c.slug} /><a href={c.route}>{c.label}</a></li>
      ))}
      <li><span class="legend-led" aria-hidden="true"></span>Green light: {simulatorLabel('tested_pass')} ({tested} of {labCount})</li>
    </ul>

    <div class="portmap-head">
      <h2 id="ports-title" class="display">Every lab, by port</h2>
      {firstLab && <p>New to networking? Start at <a href={firstLab.route}>{firstLab.id}</a>, the port with white tape.</p>}
    </div>
    <ol class="portmap">
      {byId.map((lab) => {
        const w = wireFor(lab.category);
        return (
          <li class:list={{ start: lab.id === firstLab?.id }}>
            <span class="tape">{lab.id}</span>
            <span class:list={['pm-wire', 'wire-fill', `w-${w.color}`, { striped: w.striped }]} aria-hidden="true"></span>
            <a href={lab.route}>{lab.title}</a>
            <span class="pm-meta">{difficultyLabel(lab.difficulty)}, {minutesLabel(lab.minutes)}</span>
          </li>
        );
      })}
      {capstone && (
        <li>
          <span class="tape">Capstone</span>
          <span class="pm-wire wire-fill w-capstone" aria-hidden="true"></span>
          <a href={capstone.route}>{capstone.title}</a>
          <span class="pm-meta">Combines skills from the labs above</span>
        </li>
      )}
    </ol>
  </section>

  <section class="band on-faceplate" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="display">How every lab works</h2>
      <ol class="how-steps">
        <li>
          <h3>Download the starter file</h3>
          <p>A Packet Tracer topology with the devices placed and cabled, but not yet configured.</p>
        </li>
        <li>
          <h3>Follow the walkthrough</h3>
          <p>Objectives, addressing table, tasks and the exact IOS commands, with the prompt you should see before each one.</p>
        </li>
        <li>
          <h3>Verify your work</h3>
          <p>Run the listed <code>show</code> commands and pings, and compare against the expected output.</p>
        </li>
        <li>
          <h3>Check the solution</h3>
          <p>Open the completed file only when you are done, or when you are stuck and need a reference.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="paths-title">
    <div class="section-head">
      <h2 id="paths-title" class="display">Learning paths are cable runs</h2>
      <a href={url('/learning-paths/')}>All learning paths</a>
    </div>
    <p class="section-lead">Follow one run from end to end. Each stop is a lab, in the order the path recommends.</p>
    <ul class="runs">
      {runs.map(({ path, stops, labCount: n }) => (
        <li class="run">
          <div class="run-name">
            <h3 class="display-sub"><a href={path.route}>{pathName(path.title)}</a></h3>
            <p>{path.steps.length} steps, {n} {n === 1 ? 'lab' : 'labs'}</p>
          </div>
          <ol class="run-stops" aria-label={`Labs in ${path.title}, in order`}>
            {stops.map((lab, i) => {
              const w = wireFor(lab.category);
              return (
                <li>
                  <a class:list={['stop', `w-${w.color}`, { striped: w.striped }]} href={lab.route}>{lab.id.replace(/^PTL-0*/, '')}<span class="visually-hidden">: {lab.id}, {lab.title} (stop {i + 1})</span></a>
                </li>
              );
            })}
          </ol>
        </li>
      ))}
    </ul>
  </section>

  {capstone && (
    <section class="wrap section" aria-labelledby="capstone-title">
      <div class="capstone on-steel">
        <div>
          <h2 id="capstone-title" class="display">Put it all together</h2>
          <p><a href={capstone.route}>{capstone.title}</a></p>
          {capstone.summary && <p class="capstone-summary">{capstone.summary}</p>}
        </div>
        <a class="btn btn-tape" href={capstone.route}>View the capstone</a>
      </div>
      {gettingStarted && (
        <p class="muted getting-started">New to Packet Tracer? Read the <a href={gettingStarted.route}>{gettingStarted.title}</a> guide first.</p>
      )}
    </section>
  )}
</BaseLayout>

<style>
  .hero-band { position: relative; overflow: hidden; isolation: isolate; border-bottom: 1px solid var(--c-line); }
  .hero-band > :not(.hero-net, .pdu-layer) { position: relative; }
  .hero {
    display: grid;
    gap: var(--sp-6) var(--sp-7);
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--sp-7) var(--sp-6);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); padding-block: var(--sp-8) var(--sp-7); align-items: start; }
    /* The console opens beside the headline, under the routers, like a CLI window in Packet Tracer,
       high enough to be fully visible on a typical laptop screen without scrolling. */
    .hero .hero-console { justify-self: end; width: min(100%, 31rem); margin-top: 7.5rem; }
  }
  .hero h1 { font-size: clamp(2.6rem, 1.1rem + 4.4vw, 5.4rem); font-stretch: 66%; font-weight: 850; line-height: 0.98; }
  .hero h1 span { display: block; white-space: nowrap; }
  .lead { font-size: var(--fs-md); line-height: 1.5; color: var(--c-ink-soft); max-width: 46ch; margin: var(--sp-5) 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-5); }
  .hero-note { margin: var(--sp-4) 0 0; color: var(--c-muted); font-size: var(--fs-sm); }

  .hero-console {
    margin: 0;
    background: var(--c-code-bg);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px var(--c-panel-edge), 0 18px 40px -18px rgb(0 0 0 / 0.45);
    overflow: hidden;
    color: var(--c-code-ink);
  }
  .console-bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0.9rem; background: var(--c-steel); border-bottom: 1px solid #15191d; }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--c-steel-line); }
  .console-title { margin-left: var(--sp-2); font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--c-steel-muted); }
  /* Long commands wrap rather than scroll, so the console is never a scroll region. */
  .hero-console pre { margin: 0; padding: var(--sp-4) var(--sp-5); font-family: var(--font-mono); font-size: var(--fs-sm); line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
  .hero-console code { white-space: inherit; }
  .cl { display: inline; }
  .cursor { display: inline-block; width: 0.6em; height: 1.05em; vertical-align: -0.15em; background: var(--c-prompt); }
  .hero-console figcaption { padding: var(--sp-3) var(--sp-5) var(--sp-4); border-top: 1px solid rgb(255 255 255 / 0.08); font-size: var(--fs-sm); color: var(--c-code-muted); }
  .hero-console figcaption a { color: var(--c-code-ink); }
  /* One orchestrated moment on load: the session types itself out, then the cursor blinks. */
  @media (prefers-reduced-motion: no-preference) {
    /* visibility (not opacity) so lines not yet typed are hidden, never invisible-but-present text */
    .cl { visibility: hidden; animation: cl-in 1ms linear forwards; animation-delay: calc(0.45s + var(--i) * 0.32s); }
    .cursor { animation: blink 1.1s steps(1) infinite; animation-delay: 3.6s; }
  }
  @keyframes cl-in { to { visibility: visible; } }
  @keyframes blink { 50% { opacity: 0; } }

  .hero-topics { margin-top: var(--sp-6); }
  .topics-title { font-size: var(--fs-sm); font-weight: 700; color: var(--c-ink-soft); }
  .topic-list { list-style: none; margin: var(--sp-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .topic-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-line-strong);
    background: color-mix(in srgb, var(--c-surface) 85%, transparent);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .topic-list a:hover { border-color: var(--c-ink); }
  .topic-more { display: none; }
  @media (max-width: 40rem) {
    .topic-list li:nth-child(n + 11):not(.topic-more) { display: none; }
    .topic-more { display: list-item; }
    .topic-more a { border-style: dashed; }
  }

  .panel-section { padding-top: var(--sp-7); }
  .legend {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }
  .legend li { display: inline-flex; align-items: center; gap: var(--sp-2); }
  .legend a { color: var(--c-ink); }
  .legend-led { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--c-go); box-shadow: 0 0 0 3px var(--c-go-soft); }

  .portmap-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-2) var(--sp-5); margin-top: var(--sp-8); }
  .portmap-head h2 { font-size: var(--fs-xl); }
  .portmap-head p { margin: 0; color: var(--c-ink-soft); }
  .portmap {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    column-gap: var(--sp-6);
    border-top: 2px solid var(--c-ink);
  }
  .portmap li {
    display: grid;
    grid-template-columns: 5.6rem 1.6rem minmax(0, 1fr);
    grid-template-areas: 'id wire title' '. . meta';
    align-items: baseline;
    column-gap: var(--sp-2);
    padding-block: var(--sp-3);
    border-bottom: 1px solid var(--c-line);
  }
  .portmap .tape { grid-area: id; justify-self: start; }
  .portmap li.start .tape { background: #ffffff; box-shadow: 0 0 0 2px var(--c-tape); }
  .pm-wire { grid-area: wire; height: 0.5rem; border-radius: 0.25rem; align-self: center; }
  .w-capstone { --w: #8a96a2; }
  .portmap a { grid-area: title; color: var(--c-ink); font-weight: 700; text-decoration-color: var(--c-line-strong); text-underline-offset: 0.2em; }
  .portmap a:hover { color: var(--c-link-hover); text-decoration-color: currentColor; }
  .pm-meta { grid-area: meta; color: var(--c-muted); font-size: var(--fs-sm); }

  .band { background: var(--c-surface); border-block: 1px solid var(--c-line); padding-block: var(--sp-7); margin-top: var(--sp-8); }
  .band h2, .section h2 { font-size: var(--fs-xl); }
  .how-steps {
    list-style: none;
    counter-reset: step;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .how-steps li { counter-increment: step; padding-top: var(--sp-4); border-top: 4px solid var(--c-steel); }
  .how-steps li:first-child { border-top-color: var(--c-go); }
  .how-steps li:last-child { border-top-color: var(--c-amber-line); }
  .how-steps li::before {
    content: counter(step);
    display: block;
    font-family: var(--font-display);
    font-stretch: 62%;
    font-weight: 900;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--c-muted);
  }
  .how-steps h3 { font-size: var(--fs-base); margin-top: var(--sp-2); }
  .how-steps p { margin: var(--sp-2) 0 0; color: var(--c-ink-soft); font-size: var(--fs-sm); }

  .section { padding-top: var(--sp-8); }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-2) var(--sp-5); }
  .section-lead { margin: var(--sp-2) 0 0; color: var(--c-ink-soft); max-width: 60ch; }
  .runs { list-style: none; margin: var(--sp-6) 0 0; padding: 0; display: grid; gap: var(--sp-6); }
  .run { display: grid; gap: var(--sp-3) var(--sp-6); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 60rem) { .run { grid-template-columns: 15rem minmax(0, 1fr); } }
  .run-name h3 { font-size: var(--fs-lg); }
  .run-name h3 a { color: var(--c-ink); text-decoration: none; }
  .run-name h3 a:hover { text-decoration: underline; }
  .run-name p { margin: var(--sp-1) 0 0; color: var(--c-muted); font-size: var(--fs-sm); }
  .run-stops { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; row-gap: var(--sp-3); }
  .run-stops li { display: flex; align-items: center; }
  .run-stops li + li::before { content: ''; width: 1.25rem; height: 4px; background: var(--c-run); }
  .stop {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--sp-2) 6px;
    border-radius: var(--radius-md);
    background: var(--c-surface);
    color: var(--c-ink);
    font-family: var(--font-mono);
    font-weight: 700;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
    overflow: hidden;
  }
  .stop::after { content: ''; position: absolute; inset: auto 0 0 0; height: 6px; background: var(--w); }
  .stop.striped::after { background: repeating-linear-gradient(135deg, var(--w) 0 5px, var(--wire-white) 5px 9px); }
  .stop:hover { color: var(--c-ink); box-shadow: inset 0 0 0 2px var(--c-ink); }
  @media (forced-colors: active) { .stop::after { forced-color-adjust: none; } }

  .capstone { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--sp-4) var(--sp-6); padding: var(--sp-6); border-radius: var(--radius-lg); background: var(--c-steel); color: var(--c-steel-ink); }
  .capstone h2 { color: var(--c-steel-ink); }
  .capstone p { margin: var(--sp-2) 0 0; max-width: 70ch; }
  .capstone a:not(.btn) { color: var(--c-steel-ink); font-weight: 700; }
  .capstone-summary { color: var(--c-steel-muted); }
  .getting-started { margin-top: var(--sp-5); }
  .muted { color: var(--c-muted); }
</style>
