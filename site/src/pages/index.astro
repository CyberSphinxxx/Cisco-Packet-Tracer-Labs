---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import HeroSearch from '../components/HeroSearch.astro';
import BeginnerPath from '../components/BeginnerPath.astro';
import { getRepository, labelFromSlug } from '../lib/content/repository';
import { SITE_NAME, TAGLINE, beginnerPath, labTopics, pathLabs, url } from '../lib/site';

const repo = getRepository();
const labCount = repo.labs.length;
const capstone = repo.projects[0];
const beginner = beginnerPath(repo);
const beginnerLabs = pathLabs(beginner, repo);
const topics = labTopics(repo).slice(0, 18);
const description = `${labCount} original Cisco Packet Tracer labs${capstone ? ' and a capstone project' : ''} with starter topologies, step-by-step guides, verification checks and solution files.`;
---
<BaseLayout title={`${SITE_NAME}: ${TAGLINE}`} description={description} noSearchIndex>
  <section class="hero" aria-labelledby="hero-title">
    <HeroBackdrop />
    <div class="wrap hero-inner">
      <h1 id="hero-title">
        <span class="h1-line">Learn networking by</span>
        <span class="h1-line">configuring real topologies.</span>
      </h1>
      <HeroSearch />
      {beginner && beginnerLabs.length > 0 && (
        <BeginnerPath path={beginner} labs={beginnerLabs} />
      )}
    </div>
  </section>

  {topics.length > 0 && (
    <section class="wrap topics" aria-labelledby="topics-title">
      <h2 id="topics-title">Browse by topic</h2>
      <ul class="chips">
        {topics.map((t) => <li><a class="chip" href={url(`/labs/?topic=${encodeURIComponent(t)}`)}>{labelFromSlug(t)}</a></li>)}
        <li><a class="chip chip-more" href={url('/labs/')}>All labs and topics</a></li>
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: 5rem;
    padding-bottom: 3.5rem;
  }
  .hero-inner {
    text-align: left;
  }
  .hero h1 {
    margin: 0;
    max-width: 960px;
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .h1-line {
    display: block;
  }

  .topics {
    padding-top: 3.5rem;
    padding-bottom: 3rem;
  }
  .topics h2 {
    font-size: var(--fs-lg);
    font-weight: 650;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .chip-more {
    border-style: dashed;
  }

  @media (max-width: 48rem) {
    .hero {
      padding-top: 2.75rem;
      padding-bottom: 2rem;
    }
    .topics {
      padding-top: 2.5rem;
    }
  }
</style>
