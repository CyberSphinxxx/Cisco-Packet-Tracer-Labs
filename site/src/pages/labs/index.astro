---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LabCard from '../../components/LabCard.astro';
import WireSwatch from '../../components/WireSwatch.astro';
import { getRepository, labelFromSlug } from '../../lib/content/repository';
import { facetsOf, type CatalogItem } from '../../lib/filters';
import { difficultyLabel, url } from '../../lib/site';

const repo = getRepository();
const items: CatalogItem[] = repo.labs.map((l) => ({
  id: l.id, title: l.title, summary: l.summary, category: l.category, difficulty: l.difficulty, topics: l.topics, minutes: l.minutes, order: l.learningOrder,
}));
const facets = facetsOf(items);
const count = (key: 'category' | 'difficulty', v: string) => items.filter((i) => i[key] === v).length;
const topicCounts = repo.topics;
---
<BaseLayout title="All labs" description={`Browse and filter all ${items.length} Cisco Packet Tracer labs by topic area, difficulty, topic and time.`}>
  <div class="wrap page-head">
    <Breadcrumbs items={[{ label: 'Home', href: url('/') }, { label: 'Labs' }]} />
    <h1>All labs</h1>
    <p class="intro">
      {items.length} labs, listed in the recommended order used by the learning paths. Narrow the list by topic area,
      difficulty, topic or time, or <a href={url('/search/')}>search the full text</a> of every guide.
    </p>
  </div>

  <div class="wrap catalog">
    <button type="button" class="btn filters-toggle" aria-expanded="false" aria-controls="filters-panel" data-filters-toggle hidden>Show filters</button>
    <aside class="filters" id="filters-panel" aria-labelledby="filters-title" data-filters hidden>
      <div class="filters-head">
        <h2 id="filters-title">Filter labs</h2>
        <button type="button" class="link-btn" data-reset hidden>Clear filters</button>
      </div>
      <form class="filters-form" data-filter-form role="search" aria-label="Filter labs">
        <div class="field">
          <label for="f-q">Contains words</label>
          <input id="f-q" name="q" type="search" autocomplete="off" maxlength="100" placeholder="e.g. VLAN, DHCP, PTL-0011" />
        </div>
        <fieldset>
          <legend>Topic area</legend>
          {repo.categories.map((c) => (
            <label class="check"><input type="checkbox" name="category" value={c.slug} /> <WireSwatch category={c.slug} /> <span>{c.label}</span> <span class="n">{count('category', c.slug)}</span></label>
          ))}
        </fieldset>
        <fieldset>
          <legend>Difficulty</legend>
          {facets.difficulty.map((d) => (
            <label class="check"><input type="checkbox" name="difficulty" value={d} /> <span>{difficultyLabel(d)}</span> <span class="n">{count('difficulty', d)}</span></label>
          ))}
        </fieldset>
        <div class="field">
          <label for="f-time">Time</label>
          <select id="f-time" name="time">
            <option value="">Any length</option>
            {facets.minutes.map((m) => <option value={String(m)}>{m} min or less</option>)}
          </select>
        </div>
        <details class="topics" data-topics>
          <summary>Topics <span class="n">{topicCounts.length}</span></summary>
          <fieldset>
            <legend class="visually-hidden">Topics</legend>
            {topicCounts.map((t) => (
              <label class="check"><input type="checkbox" name="topic" value={t.slug} /> <span>{t.label}</span> <span class="n">{t.count}</span></label>
            ))}
          </fieldset>
        </details>
      </form>
    </aside>

    <section class="results" aria-labelledby="results-title">
      <div class="results-head">
        <h2 id="results-title" class="visually-hidden">Labs</h2>
        <p class="results-count" role="status" aria-live="polite" data-count>Showing all {items.length} labs</p>
        <div class="sort" data-sort-wrap hidden>
          <label for="f-sort">Sort by</label>
          <select id="f-sort" name="sort">
            <option value="recommended">Recommended order</option>
            <option value="title">Title (A to Z)</option>
            <option value="time">Shortest first</option>
            <option value="difficulty">Easiest first</option>
          </select>
        </div>
      </div>
      <ol class="lab-list" data-lab-list>
        {repo.labs.map((lab) => <LabCard lab={lab} />)}
      </ol>
      <div class="empty" data-empty hidden>
        <p><strong>No labs match these filters.</strong> Remove a filter or clear them all to see every lab.</p>
        <button type="button" class="btn" data-reset>Clear filters</button>
      </div>
      <p class="noscript nojs-only">Filtering needs JavaScript. Browse by topic area instead:
        {repo.categories.map((c, i) => <>{i > 0 && ', '}<a href={c.route}>{c.label}</a></>)}.
      </p>
    </section>
  </div>

  <script type="application/json" id="catalog-data" set:html={JSON.stringify({ items, facets })} />
  <script>
    import '../../scripts/catalog.ts';
  </script>
</BaseLayout>

<style>
  .page-head { padding-top: var(--sp-5); }
  .page-head h1 { font-size: var(--fs-xl); margin-top: var(--sp-3); letter-spacing: -0.01em; }
  .intro { color: var(--c-ink-soft); max-width: 66ch; margin: var(--sp-3) 0 0; }
  .catalog { display: grid; gap: var(--sp-5) var(--sp-7); grid-template-columns: minmax(0, 1fr); margin-top: var(--sp-5); }
  @media (min-width: 62rem) { .catalog { grid-template-columns: 17rem minmax(0, 1fr); } }
  .filters { align-self: start; }
  @media (min-width: 62rem) { .filters { position: sticky; top: calc(var(--header-h) + var(--sp-4)); max-height: calc(100vh - var(--header-h) - var(--sp-6)); overflow-y: auto; padding-right: var(--sp-2); } }
  .filters-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-3); }
  .filters h2 { font-size: var(--fs-md); }
  .filters-form { display: grid; gap: var(--sp-5); margin-top: var(--sp-4); }
  .field { display: grid; gap: var(--sp-1); }
  label, legend, summary { font-weight: 700; font-size: var(--fs-sm); }
  input[type='search'], select {
    font: inherit; font-size: var(--fs-sm); min-height: 2.5rem; padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--c-line-strong); border-radius: var(--radius-md); background: var(--c-surface); color: var(--c-ink); width: 100%;
  }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: var(--sp-1); }
  legend { margin-bottom: var(--sp-2); padding: 0; }
  .check { display: flex; align-items: center; gap: var(--sp-2); font-weight: 400; min-height: 2rem; cursor: pointer; }
  .check input { width: 1.1rem; height: 1.1rem; accent-color: var(--c-go); flex: none; margin: 0; }
  .n { margin-left: auto; color: var(--c-muted); font-weight: 400; font-variant-numeric: tabular-nums; font-size: var(--fs-xs); }
  .topics summary { cursor: pointer; display: flex; gap: var(--sp-2); min-height: 2rem; align-items: center; }
  .topics fieldset { margin-top: var(--sp-2); }
  .link-btn { background: none; border: 0; padding: var(--sp-1); color: var(--c-link); font: inherit; font-size: var(--fs-sm); text-decoration: underline; cursor: pointer; }
  .results-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3) var(--sp-5); padding-bottom: var(--sp-3); border-bottom: 2px solid var(--c-ink); }
  .results-count { margin: 0; font-weight: 700; margin-right: auto; }
  .sort { display: flex; align-items: center; gap: var(--sp-2); }
  .sort select { width: auto; }
  .lab-list { list-style: none; margin: 0; padding: 0; }
  .empty { padding: var(--sp-6) 0; }
  .empty p { margin: 0 0 var(--sp-4); }
  .noscript { color: var(--c-muted); }
  @media (max-width: 61.99rem) {
    .filters-toggle { justify-self: start; }
    :global(.js) .filters:not([data-open]) { display: none; }
    .filters[data-open] { padding: var(--sp-4); border: 1px solid var(--c-line); border-radius: var(--radius-lg); background: var(--c-surface); }
  }
  @media (min-width: 62rem) { .filters-toggle { display: none !important; } }
</style>
