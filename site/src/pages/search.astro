---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { url } from '../lib/site';
---
<BaseLayout title="Search" description="Search the full text of every lab guide, learning path and reference guide." noSearchIndex>
  <div class="wrap page-head">
    <Breadcrumbs items={[{ label: 'Home', href: url('/') }, { label: 'Search' }]} />
    <h1>Search</h1>
    <p>Full-text search is added in the next build phase. Until then, <a href={url('/labs/')}>browse and filter all labs</a>.</p>
  </div>
</BaseLayout>
<style>
  .page-head { padding-top: var(--sp-5); }
  .page-head h1 { font-size: var(--fs-xl); margin-top: var(--sp-3); }
</style>
