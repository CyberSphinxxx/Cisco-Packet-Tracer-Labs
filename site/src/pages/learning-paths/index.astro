---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getRepository } from '../../lib/content/repository';
import { url } from '../../lib/site';
const repo = getRepository();
---
<BaseLayout title="Learning paths" description={`${repo.paths.length} curated sequences through the Cisco Packet Tracer labs: ${repo.paths.map((p) => p.title).join(', ')}.`} noSearchIndex>
  <div class="wrap page-head">
    <Breadcrumbs items={[{ label: 'Home', href: url('/') }, { label: 'Learning paths' }]} />
    <h1>Learning paths</h1>
    <p class="intro">Each path is a curated order through the labs and reference guides. Pick the one that matches where you are starting from.</p>
  </div>
  <div class="wrap">
    <ol class="paths">
      {repo.paths.map((p) => {
        const labs = p.steps.filter((s) => s.kind === 'lab');
        return (
          <li>
            <h2><a href={p.route}>{p.title}</a></h2>
            {p.summary && <p>{p.summary}</p>}
            <p class="count">{p.steps.length} steps: {labs.length} labs{p.steps.length - labs.length > 0 && `, ${p.steps.length - labs.length} guides or projects`}</p>
            <ol class="preview">
              {p.steps.slice(0, 4).map((s) => <li><a href={s.url}>{s.label}</a></li>)}
              {p.steps.length > 4 && <li class="more"><a href={p.route}>{p.steps.length - 4} more steps</a></li>}
            </ol>
          </li>
        );
      })}
    </ol>
  </div>
</BaseLayout>
<style>
  .paths { list-style: none; margin: var(--sp-6) 0 0; padding: 0; display: grid; gap: 1.25rem; }
  .paths > li { padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .paths h2 { font-size: var(--fs-xl); letter-spacing: -0.025em; }
  .paths h2 a { text-decoration: none; }
  .paths h2 a:hover { text-decoration: underline; }
  .paths p { margin: var(--sp-2) 0 0; max-width: 70ch; color: var(--ink-2); }
  .paths .count { color: var(--muted); font-size: var(--fs-sm); }
  .preview { margin: var(--sp-3) 0 0; padding-left: 1.4em; font-size: var(--fs-sm); display: grid; gap: var(--sp-1); }
  .preview .more { list-style: none; margin-left: -1.4em; }
  .preview .more a { color: var(--link); }
</style>
