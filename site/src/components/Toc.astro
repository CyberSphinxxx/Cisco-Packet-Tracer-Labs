---
/** "On this page" navigation from the rendered headings (h2 with nested h3). */
import type { HeadingInfo } from '../lib/content/markdown';
import TocList, { type TocNode } from './TocList.astro';
interface Props { headings: HeadingInfo[]; variant: 'sidebar' | 'inline'; extra?: { id: string; text: string }[] }
const { headings, variant, extra = [] } = Astro.props;
const tree: TocNode[] = [];
for (const h of headings) {
  if (h.depth === 2 || tree.length === 0) tree.push({ h, children: [] });
  else tree[tree.length - 1].children.push(h);
}
for (const e of extra) tree.push({ h: e, children: [] });
---
{tree.length > 0 && (variant === 'sidebar' ? (
  <nav class="toc toc-sidebar" aria-label="On this page" data-pagefind-ignore>
    <p class="toc-title">On this page</p>
    <TocList tree={tree} />
  </nav>
) : (
  <details class="toc toc-inline" data-pagefind-ignore>
    <summary>On this page</summary>
    <nav aria-label="On this page (collapsed)"><TocList tree={tree} /></nav>
  </details>
))}
<style>
  .toc { font-size: var(--fs-sm); }
  .toc :global(ol) { list-style: none; margin: 0; padding: 0; }
  .toc :global(ol ol) { padding-left: var(--sp-4); margin-block: var(--sp-1); }
  .toc :global(a) {
    position: relative;
    display: block;
    padding: 0.28rem var(--sp-2) 0.28rem 1.35rem;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: 8px;
    line-height: 1.35;
  }
  /* each entry has a link light, lit once you reach it */
  .toc :global(a)::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.72em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .toc :global(a:hover) { color: var(--ink); background: var(--chip-active); }
  .toc :global(a[aria-current='true']) { color: var(--ink); font-weight: 600; background: var(--chip-active); }
  .toc :global(a[aria-current='true'])::before { background: var(--accent); box-shadow: 0 0 0 3px var(--tag-green-bg); }
  .toc :global(.toc-prompt) {
    display: block;
    margin-top: 0.1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .toc-title { margin: 0 0 var(--sp-2); font-weight: 650; font-size: var(--fs-base); letter-spacing: -0.015em; color: var(--ink); }
  .toc-sidebar { position: sticky; top: calc(var(--header-h) + var(--sp-5)); max-height: calc(100vh - var(--header-h) - var(--sp-7)); overflow-y: auto; padding: var(--sp-4); border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .toc-inline { border: 1px solid var(--line); border-radius: var(--radius-code); background: var(--surface); }
  .toc-inline summary { padding: var(--sp-3) var(--sp-4); cursor: pointer; font-weight: 600; min-height: 2.75rem; }
  .toc-inline nav { padding: 0 var(--sp-3) var(--sp-3); }
  @media (forced-colors: active) { .toc :global(a)::before { forced-color-adjust: none; border: 1px solid CanvasText; } }
</style>
