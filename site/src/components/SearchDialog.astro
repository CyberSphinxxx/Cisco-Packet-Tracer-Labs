---
/**
 * The header search dialog: the same terminal box, results list and preview
 * as the homepage search, in a wide modal. Opens from the header search icon,
 * "/" and Ctrl/Cmd+K. Before anything is typed it suggests where to start.
 */
import LabSearch from './LabSearch.astro';
---
<dialog class="search-dialog" aria-label="Search" data-search-dialog>
  <LabSearch variant="dialog" idPrefix="dialog" />
  <p class="search-dialog-foot" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>enter</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
  </p>
</dialog>
<style>
  .search-dialog {
    width: min(60rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 4rem);
    margin: 9vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-term);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }
  .search-dialog[open] { animation: sd-in 160ms var(--ease); }
  @keyframes sd-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.99); }
  }
  .search-dialog::backdrop { background: rgb(10 12 14 / 0.6); backdrop-filter: blur(2px); }
  .search-dialog-foot {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0.6rem 1.4rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    color: var(--muted);
  }
  .search-dialog-foot kbd {
    display: inline-block;
    min-width: 1.4em;
    margin-right: 0.25rem;
    padding: 0 0.3rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: inherit;
    text-align: center;
  }
  @media (max-width: 40rem) {
    .search-dialog { width: 100vw; max-width: 100vw; max-height: 100dvh; height: 100dvh; margin: 0; border: 0; border-radius: 0; }
    .search-dialog-foot { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open] { animation: none; }
  }
</style>
<script>
  import { loadIndex, mountLabSearch } from '../scripts/lab-search.ts';
  import { loadPagefind } from '../scripts/search-core.ts';
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const triggers = document.querySelectorAll<HTMLAnchorElement>('[data-search-trigger]');
  const root = dialog?.querySelector<HTMLElement>('[data-lab-search]');
  if (dialog && root && typeof dialog.showModal === 'function') {
    const search = mountLabSearch(root, { limit: 10, suggestWhenEmpty: true });
    const { input } = search;
    let returnFocus: HTMLElement | null = null;
    const open = (from?: HTMLElement | null) => {
      returnFocus = from ?? (document.activeElement as HTMLElement | null);
      dialog.showModal();
      input.focus();
      input.select();
      search.refresh();
    };
    dialog.addEventListener('close', () => returnFocus?.focus());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        dialog.close();
      }
    });
    dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close(); // backdrop click
    });
    // Warm the index as soon as the reader shows intent, so the first
    // results appear without waiting for a download.
    const warm = () => {
      void loadIndex();
      void loadPagefind().then((p) => p?.init?.());
    };
    for (const t of triggers) {
      t.addEventListener('pointerenter', warm, { once: true });
      t.addEventListener('focus', warm, { once: true });
      t.addEventListener('touchstart', warm, { once: true, passive: true });
      t.setAttribute('aria-haspopup', 'dialog');
      t.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        open(t);
      });
    }
    // On the homepage "/" goes to the hero search box while it is on screen.
    const hero = document.querySelector<HTMLInputElement>('[data-hero-input]');
    const heroInView = () => {
      if (!hero) return false;
      const r = hero.getBoundingClientRect();
      return r.width > 0 && r.top >= 0 && r.bottom <= window.innerHeight;
    };
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const typing = target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
      if (e.key === '/' && !typing && !dialog.open && heroInView()) {
        e.preventDefault();
        hero!.focus();
        hero!.select();
      } else if ((e.key === '/' && !typing && !dialog.open) || ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey))) {
        e.preventDefault();
        if (!dialog.open) open(triggers[0] ?? null);
      }
    });
  }
</script>
