---
import type { VerificationPage } from '../lib/content/repository';
interface Props { page: VerificationPage }
const { page } = Astro.props;
---
<header class="ver-header">
  <h1>{page.title}</h1>
  <p class="ver-note">
    Assembly details and expected results for <a href={page.parentRoute}>{page.parentTitle}</a>.
    It shows the finished configuration, so use it to check your work.
  </p>
  <span hidden data-pagefind-filter="type">Verification guide</span>
</header>
<style>
  .ver-header h1 { font-size: var(--fs-xl); line-height: var(--lh-snug); margin-top: var(--sp-3); max-width: 30ch; }
  .ver-note { color: var(--c-ink-soft); max-width: 62ch; margin: var(--sp-3) 0 0; }
</style>
