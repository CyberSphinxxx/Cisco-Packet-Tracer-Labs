---
/**
 * Decorative hero background: a small campus network (routers, switches, PCs
 * and a WAN link) with packets travelling along the links, like Packet
 * Tracer's simulation mode. Purely visual (aria-hidden). Packets are HTML
 * elements animated with CSS transform/opacity (compositor-only); they are
 * hidden for readers who prefer reduced motion and paused while off-screen.
 */
type Kind = 'router' | 'switch' | 'pc';
const nodes: { x: number; y: number; kind: Kind }[] = [
  { x: 820, y: 118, kind: 'router' },
  { x: 1190, y: 96, kind: 'router' },
  { x: 917, y: 330, kind: 'switch' },
  { x: 1396, y: 286, kind: 'switch' },
  { x: 900, y: 700, kind: 'pc' },
  { x: 1060, y: 722, kind: 'pc' },
  { x: 1232, y: 708, kind: 'pc' },
  { x: 1404, y: 690, kind: 'pc' },
];
// Links: [id, path]. Paths run node centre to node centre.
const links: [string, string][] = [
  ['wan', 'M-40 46 C 260 -10, 560 150, 820 118'],
  ['r1r2', 'M820 118 L1190 96'],
  ['r1s1', 'M820 118 L917 330'],
  ['r2s2', 'M1190 96 L1396 286'],
  ['s1s2', 'M917 330 L1396 286'],
  ['s1p1', 'M917 330 L900 700'],
  ['s1p2', 'M917 330 L1060 722'],
  ['s2p3', 'M1396 286 L1232 708'],
  ['s2p4', 'M1396 286 L1404 690'],
];
// Packets: [link, colour, duration s, delay s, reverse]
const packets: [string, string, number, number, boolean][] = [
  ['r1r2', 'green', 3.2, 0.6, false],
  ['r1r2', 'brown', 3.2, 2.2, true],
  ['r1s1', 'orange', 2.4, 1.4, false],
  ['r2s2', 'blue', 2.8, 3.6, false],
  ['s1s2', 'green', 4.4, 2.0, false],
  ['s1p1', 'orange', 3, 4.0, false],
  ['s2p4', 'brown', 2.6, 1.0, false],
  ['s2p3', 'blue', 3, 5.2, true],
  ['s1p2', 'green', 3.2, 1.8, true],
];

// Packets run on the straight links (end point to end point). The WAN link
// stays static: at the hero's scale it passes behind the headline.
const nums = (d: string) => (d.match(/-?\d+(\.\d+)?/g) ?? []).map(Number);
function waypoints(d: string): [number, number][] {
  const n = nums(d);
  return [[n[0], n[1]], [n[2], n[3]]];
}
const linkPath = Object.fromEntries(links);
const pdus = packets.map(([link, color, dur, delay, reverse], i) => {
  let pts = waypoints(linkPath[link]);
  if (reverse) pts = [...pts].reverse();
  const vars = pts.map(([x, y], k) => `--x${k}: ${x.toFixed(1)}px; --y${k}: ${y.toFixed(1)}px;`).join(' ');
  return { key: i, color, style: `${vars} animation-name: pdu-line; animation-duration: ${dur}s; animation-delay: ${delay}s;` };
});
---
<svg class="hero-net" viewBox="0 0 1440 760" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
  <g class="links">
    {links.map(([id, d]) => <path d={d} class:list={['link', { trunk: id === 's1s2', wan: id === 'wan' }]} />)}
  </g>

  <g class="nodes">
    {nodes.map((n) =>
      n.kind === 'router' ? (
        <g transform={`translate(${n.x} ${n.y})`} class="node">
          <circle r="24" />
          <path d="M-12 0h24M0 -12v24M7 -5l5 5-5 5M-7 -5l-5 5 5 5" fill="none" />
        </g>
      ) : n.kind === 'switch' ? (
        <g transform={`translate(${n.x} ${n.y})`} class="node">
          <rect x="-30" y="-16" width="60" height="32" rx="4" />
          <path d="M-16 -5h30M10 -9l4 4-4 4M16 5h-30M-10 1l-4 4 4 4" fill="none" />
        </g>
      ) : (
        <g transform={`translate(${n.x} ${n.y})`} class="node">
          <rect x="-18" y="-15" width="36" height="24" rx="2" />
          <path d="M-8 15h16M0 9v6" fill="none" />
        </g>
      ),
    )}
  </g>
</svg>

<!-- Packets: HTML elements animated with transform and opacity only, so the
     compositor moves them and the main thread stays idle. A small script maps
     this 1440x760 layer onto the diagram (same "slice, right, middle" fit). -->
<div class="pdu-layer" aria-hidden="true" data-pdu-layer>
  {pdus.map((p) => (
    <span class={`pdu pdu-${p.color}`} style={p.style}>
      <svg viewBox="-11 -8 22 16" width="22" height="16" focusable="false"><rect x="-10" y="-7" width="20" height="14" rx="2" /><path d="M-10 -7 L0 1.5 L10 -7" fill="none" /></svg>
    </span>
  ))}
</div>

<script>
  // Fit the packet layer to the diagram (preserveAspectRatio="xMaxYMid slice")
  // and pause the animation whenever the hero is off-screen.
  const layer = document.querySelector<HTMLElement>('[data-pdu-layer]');
  const band = layer?.parentElement;
  if (layer && band) {
    const fit = () => {
      const w = band.clientWidth;
      const h = band.clientHeight;
      const s = Math.max(w / 1440, h / 760);
      layer.style.transform = `translate(${w - 1440 * s}px, ${(h - 760 * s) / 2}px) scale(${s})`;
    };
    fit();
    new ResizeObserver(fit).observe(band);
    layer.classList.add('ready');
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => layer.classList.toggle('paused', !e.isIntersecting)).observe(band);
    }
  }
</script>

<style>
  .hero-net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-net {
    /* Fade out behind the headline so the copy stays clean. */
    -webkit-mask-image: linear-gradient(to right, rgb(0 0 0 / 0.12) 0%, rgb(0 0 0 / 0.22) 36%, #000 54%);
    mask-image: linear-gradient(to right, rgb(0 0 0 / 0.12) 0%, rgb(0 0 0 / 0.22) 36%, #000 54%);
  }
  .link { fill: none; stroke: var(--net-line); stroke-width: 2; }
  .link.trunk { stroke-dasharray: 8 6; }
  .link.wan { stroke-dasharray: 2 7; stroke-linecap: round; stroke-width: 2.5; }
  .node circle, .node rect { fill: var(--net-fill); stroke: var(--net-line); stroke-width: 2.5; }
  .node path { stroke: var(--net-line); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .pdu-layer { position: absolute; top: 0; left: 0; width: 1440px; height: 760px; transform-origin: 0 0; pointer-events: none; visibility: hidden; }
  .pdu-layer.ready { visibility: visible; }
  .pdu {
    position: absolute;
    left: -11px;
    top: -8px;
    opacity: 0;
    will-change: transform, opacity;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-fill-mode: backwards;
  }
  .pdu-layer.paused .pdu { animation-play-state: paused; }
  .pdu svg { display: block; }
  .pdu rect, .pdu path { stroke: var(--net-pdu-edge); stroke-width: 1.4; stroke-linejoin: round; }
  .pdu-blue rect { fill: var(--wire-blue); }
  .pdu-green rect { fill: var(--wire-green); }
  .pdu-orange rect { fill: var(--wire-orange); }
  .pdu-brown rect { fill: var(--wire-brown); }
  @keyframes pdu-line {
    0% { transform: translate(var(--x0), var(--y0)); opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { transform: translate(var(--x1), var(--y1)); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pdu-layer { display: none; }
  }
  /* Narrow screens stack the hero; the diagram would sit behind the text. */
  @media (max-width: 71.99rem) {
    .hero-net, .pdu-layer { display: none; }
  }
  @media (forced-colors: active) {
    .hero-net, .pdu-layer { display: none; }
  }
</style>
