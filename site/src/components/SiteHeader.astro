---
import { getRepository } from '../lib/content/repository';
import { navItems, SHORT_NAME, url } from '../lib/site';
import RJ45Mark from './RJ45Mark.astro';

const current = Astro.url.pathname;
const items = navItems(getRepository());
const githubUrl = getRepository().config.repoUrl;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={url('/')}>
      <RJ45Mark size={30} uid="header-rj45" />
      <span class="brand-text">{SHORT_NAME}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <span class="menu-label">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {items.map((item) => (
          <li><a href={item.href} aria-current={current.startsWith(item.match) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a href={githubUrl} rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </nav>

    <div class="header-tools">
      <a class="search-trigger" href={url('/search/')} data-search-trigger>
        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span class="search-label">Search</span>
        <kbd class="search-kbd" hidden>/</kbd>
      </a>
      <button class="theme-toggle" type="button" hidden aria-label="Switch to dark theme" data-theme-toggle>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 12.5A6.5 6.5 0 0 1 7.5 4.5a6.5 6.5 0 1 0 8 8Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M10 1.5v2.2M10 16.3v2.2M1.5 10h2.2M16.3 10h2.2M4 4l1.5 1.5M14.5 14.5 16 16M4 16l1.5-1.5M14.5 5.5 16 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--c-ink);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-md);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .brand:hover { color: var(--c-ink); }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    display: inline-block;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-md);
    color: var(--c-ink-soft);
    text-decoration: none;
    font-weight: 600;
  }
  .site-nav a:hover { color: var(--c-ink); background: var(--c-surface-sunk); }
  .site-nav a[aria-current='page'] {
    color: var(--c-ink);
    box-shadow: inset 0 -3px 0 var(--c-go);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  .header-tools { display: flex; align-items: center; gap: var(--sp-2); }
  .search-trigger, .theme-toggle, .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 2.5rem;
    min-width: 2.5rem;
    justify-content: center;
    padding: var(--sp-1) var(--sp-3);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    color: var(--c-ink-soft);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .search-trigger:hover, .theme-toggle:hover, .menu-toggle:hover { color: var(--c-ink); border-color: var(--c-line-strong); }
  .search-kbd {
    font-size: var(--fs-xs);
    padding: 0 0.4em;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-sm);
    color: var(--c-muted);
  }
  .theme-toggle .icon-sun { display: none; }
  :global([data-resolved-theme='dark']) .theme-toggle .icon-sun { display: block; }
  :global([data-resolved-theme='dark']) .theme-toggle .icon-moon { display: none; }

  /* Small screens: with JS, the nav collapses behind the Menu button.
     Without JS it stays visible and wraps under the brand. */
  @media (max-width: 60rem) {
    .header-inner { flex-wrap: wrap; gap: var(--sp-2) var(--sp-3); padding-block: var(--sp-2); }
    .site-nav { order: 3; width: 100%; }
    .header-inner { flex-wrap: wrap; }
    .header-tools { order: 1; }
    .menu-toggle { order: 2; }
    .brand { gap: var(--sp-2); }
    .brand-text { font-size: var(--fs-sm); max-width: 9.5em; line-height: 1.15; }
    .search-label { display: none; }
    :global(.js) .menu-toggle { display: inline-flex; }
    :global(.js) .site-nav { display: none; }
    :global(.js) .site-nav[data-open] { display: block; }
    :global(.js) .site-nav[data-open] ul { flex-direction: column; padding-bottom: var(--sp-3); }
    :global(.js) .site-nav[data-open] a { display: block; padding: var(--sp-3); }
    :global(.js) .site-nav[data-open] a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--c-go); border-radius: 0; }
  }
  @media (max-width: 26.25rem) {
    .header-inner { column-gap: var(--sp-2); }
    .search-trigger, .theme-toggle, .menu-toggle { padding-inline: var(--sp-2); }
    .menu-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (min-width: 60.01rem) {
    .menu-toggle { display: none !important; }
  }
</style>
