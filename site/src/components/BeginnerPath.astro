---
/**
 * "New here? Follow the beginner path": the beginner path's labs as stations
 * on a gently curving link, with small packets travelling from lab to lab and
 * each station pinging as a packet arrives.
 *
 * The curve is an SVG path stretched horizontally only (preserveAspectRatio
 * "none" with a pixel-high viewBox), so station x positions are the centres
 * of equal grid columns and nothing distorts vertically. Packets are HTML
 * dots animated with the Web Animations API using transform and opacity only
 * (compositor-friendly, no SMIL); a script samples the curve at the current
 * width, rebuilds on resize, and pauses while off-screen. Reduced motion and
 * narrow screens (where the track becomes a vertical list) get no motion.
 */
import type { Lab, LearningPath } from '../lib/content/repository';
import { shortLabTitle, totalTimeLabel } from '../lib/site';

interface Props {
  path: LearningPath;
  labs: Lab[];
}
const { labs } = Astro.props;
const n = labs.length;
// Geometry, in viewBox units: 100 per column horizontally, pixels vertically.
const BAND = 72;
const Y_LOW = 50;
const Y_HIGH = 18;
const W = n * 100;
const STUB = 34;
const xAt = (i: number) => i * 100 + 50;
const yAt = (i: number) => (i % 2 ? Y_HIGH : Y_LOW);
let d = `M ${xAt(0)} ${yAt(0)}`;
for (let i = 1; i < n; i++) d += ` C ${xAt(i - 1) + 50} ${yAt(i - 1)}, ${xAt(i) - 50} ${yAt(i)}, ${xAt(i)} ${yAt(i)}`;
const last = n - 1;
const stubY = yAt(last) + (last % 2 ? 10 : -10);
const stub = `M ${xAt(last)} ${yAt(last)} C ${xAt(last) + 26} ${yAt(last)}, ${W + STUB - 20} ${stubY}, ${W + STUB} ${stubY}`;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
{n > 0 && (
  <section class="wrap bp" aria-labelledby="bp-title" data-beginner-path>
    <div class="bp-head">
      <h2 id="bp-title">New here? Follow the beginner path</h2>
      <p class="bp-sum">{n} {n === 1 ? 'LAB' : 'LABS'} · {totalTimeLabel(labs).toUpperCase()}</p>
      <a class="bp-start" href={labs[0].route} aria-label="Start with lab 1">Start lab 01 <span aria-hidden="true">→</span></a>
    </div>
    <div class="bp-track" style={`--n: ${n}; --band: ${BAND}px; --y-low: ${Y_LOW}px; --y-high: ${Y_HIGH}px;`} data-bp-track data-y-low={Y_LOW} data-y-high={Y_HIGH}>
      <svg class="bp-wire" viewBox={`0 0 ${W} ${BAND}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="bp-line" d={d} />
        <path class="bp-line bp-line-stub" d={stub} />
      </svg>
      <span class="bp-end" aria-hidden="true" style={`left: ${(((W + STUB) / W) * 100).toFixed(3)}%; top: ${stubY}px;`}></span>
      <ol class="bp-steps">
        {labs.map((lab, i) => (
          <li class:list={['bp-step', i % 2 ? 'is-high' : 'is-low', i === 0 && 'is-first']} data-lab-id={lab.id}>
            <a href={lab.route} title={`${lab.id}: ${lab.title}`}>
              <span class="bp-node" aria-hidden="true">
                <span class="bp-ring"></span>
                <span class="bp-pulse"></span>
                <span class="bp-sq"></span>
              </span>
              <span class="bp-meta">{pad(i)} · {lab.minutes != null ? `${lab.minutes} min` : lab.id}</span>
              <span class="bp-label">{shortLabTitle(lab.title, lab.id)}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="bp-motion" aria-hidden="true" data-bp-motion></div>
    </div>
  </section>
)}

<script>
  const track = document.querySelector<HTMLElement>('[data-bp-track]');
  const motion = track?.querySelector<HTMLElement>('[data-bp-motion]');
  if (track && motion && typeof Element.prototype.animate === 'function') {
    const pulses = [...track.querySelectorAll<HTMLElement>('.bp-pulse')];
    const n = pulses.length;
    const yLow = Number(track.dataset.yLow);
    const yHigh = Number(track.dataset.yHigh);
    const wide = matchMedia('(min-width: 48rem)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const SEG = 1500; // ms per hop between stations
    const PACKETS = 3; // evenly spaced around the loop
    const TRAIL: [number, number][] = [[7, 1], [5, 0.6], [4, 0.38], [3, 0.2]]; // [size px, opacity]
    const LAG = 70; // ms between trail dots
    let anims: Animation[] = [];
    let onScreen = true;
    let builtWidth = -1;

    const bezier = (p0: number, p1: number, p2: number, p3: number, t: number) => {
      const u = 1 - t;
      return u * u * u * p0 + 3 * u * u * t * p1 + 3 * u * t * t * p2 + t * t * t * p3;
    };

    const clear = () => {
      for (const a of anims) a.cancel();
      anims = [];
      motion.replaceChildren();
    };

    const build = () => {
      clear();
      builtWidth = track.clientWidth;
      if (n < 2 || !wide.matches || still.matches) return;
      const w = builtWidth;
      const xs = Array.from({ length: n }, (_, i) => ((i + 0.5) / n) * w);
      const ys = Array.from({ length: n }, (_, i) => (i % 2 ? yHigh : yLow));
      // Sample the same curve the SVG draws, with stations at equal time steps.
      const S = 14;
      const frames: { offset: number; x: number; y: number }[] = [];
      for (let i = 0; i < n - 1; i++) {
        const dx = xs[i + 1] - xs[i];
        for (let k = 0; k < S; k++) {
          const t = k / S;
          frames.push({
            offset: (i + t) / (n - 1),
            x: bezier(xs[i], xs[i] + dx / 2, xs[i + 1] - dx / 2, xs[i + 1], t),
            y: bezier(ys[i], ys[i], ys[i + 1], ys[i + 1], t),
          });
        }
      }
      frames.push({ offset: 1, x: xs[n - 1], y: ys[n - 1] });
      const fade = 0.04;
      const alpha = (o: number) => Math.max(0, Math.min(1, o / fade, (1 - o) / fade));
      const D = SEG * (n - 1);
      for (let p = 0; p < PACKETS; p++) {
        for (const [j, [size, op]] of TRAIL.entries()) {
          const dot = document.createElement('span');
          dot.className = 'bp-dot';
          dot.style.width = dot.style.height = `${size}px`;
          dot.style.margin = `${-size / 2}px 0 0 ${-size / 2}px`;
          motion.append(dot);
          const keyframes = frames.map((f) => ({ offset: f.offset, transform: `translate(${f.x.toFixed(1)}px, ${f.y.toFixed(1)}px)`, opacity: +(alpha(f.offset) * op).toFixed(3) }));
          anims.push(dot.animate(keyframes, { duration: D, iterations: Infinity, delay: -((p * D) / PACKETS) + j * LAG, easing: 'linear' }));
        }
      }
      // Each station pings when a packet arrives: every D / PACKETS, offset by its hop count.
      const period = D / PACKETS;
      pulses.forEach((el, i) => {
        anims.push(
          el.animate(
            [
              { offset: 0, transform: 'scale(0.55)', opacity: 0.85 },
              { offset: 0.45, transform: 'scale(1.9)', opacity: 0 },
              { offset: 1, transform: 'scale(1.9)', opacity: 0 },
            ],
            { duration: period, iterations: Infinity, delay: (i * SEG) % period, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' },
          ),
        );
      });
      sync();
    };

    const sync = () => {
      const run = onScreen && !document.hidden;
      for (const a of anims) {
        if (run) a.play();
        else a.pause();
      }
      track.classList.toggle('paused', !run);
    };

    let raf = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        if (track.clientWidth !== builtWidth) build();
      });
    }).observe(track);
    wide.addEventListener('change', build);
    still.addEventListener('change', build);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        onScreen = e.isIntersecting;
        sync();
      }).observe(track);
    }
    document.addEventListener('visibilitychange', sync);
    build();
    track.classList.add('ready');
  }
</script>

<style>
  .bp { position: relative; padding-top: 4.5rem; }
  .bp-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin-bottom: 1.75rem; }
  .bp-head h2 { font-size: 1rem; font-weight: 650; letter-spacing: -0.01em; }
  .bp-sum { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .bp-start { margin-left: auto; font-size: 0.9375rem; font-weight: 650; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .bp-start span { display: inline-block; transition: transform var(--dur) var(--ease); }
  .bp-start:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .bp-start:hover span { transform: translateX(3px); }

  .bp-track { position: relative; width: 95%; }
  .bp-wire { position: absolute; top: 0; left: 0; width: 100%; height: var(--band); overflow: visible; pointer-events: none; }
  .bp-line { fill: none; stroke: var(--line-strong); stroke-width: 1.25; vector-effect: non-scaling-stroke; }
  .bp-line-stub { stroke-dasharray: 3 4; opacity: 0.8; }
  .bp-end { position: absolute; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border: 1px solid var(--line-strong); background: var(--bg); }

  .bp-steps { position: relative; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .bp-step a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: calc(var(--band) + 0.6rem) 0.35rem 0.25rem;
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
  }
  .bp-node { position: absolute; left: 50%; top: var(--y-low); width: 0; height: 0; }
  .is-high .bp-node { top: var(--y-high); }
  .bp-ring, .bp-pulse, .bp-sq { position: absolute; left: 0; top: 0; }
  .bp-ring { width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; border: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 70%, transparent); }
  .bp-pulse { width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; border: 1.25px solid var(--accent); opacity: 0; }
  .bp-sq { width: 12px; height: 12px; margin: -6px 0 0 -6px; border: 1.5px solid var(--ink-2); background: var(--bg); transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease); }
  .is-first .bp-sq { border-color: var(--accent); background: var(--accent); border-radius: 2px; }
  .bp-sq { border-radius: 2px; }
  .bp-meta { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tag-green); white-space: nowrap; }
  .bp-label { font-size: 0.875rem; font-weight: 500; line-height: 1.3; text-wrap: balance; }
  .bp-step a:hover .bp-sq { border-color: var(--accent); }
  .bp-step a:hover .bp-ring { border-color: var(--line-strong); }
  .bp-step a:hover .bp-label { text-decoration: underline; text-underline-offset: 0.2em; }

  .bp-motion { position: absolute; top: 0; left: 0; width: 100%; height: var(--band); pointer-events: none; }
  .bp-motion :global(.bp-dot) { position: absolute; left: 0; top: 0; border-radius: 50%; background: var(--accent); opacity: 0; will-change: transform, opacity; }

  /* Narrow screens: a vertical list, stations down the left on a straight link. */
  @media (max-width: 47.99rem) {
    .bp { padding-top: 3rem; }
    .bp-start { margin-left: 0; flex-basis: 100%; }
    .bp-track { width: 100%; }
    .bp-wire, .bp-end, .bp-motion, .bp-ring, .bp-pulse { display: none; }
    .bp-steps { grid-template-columns: minmax(0, 1fr); }
    .bp-steps::before { content: ''; position: absolute; left: 6px; top: 1.3rem; bottom: 1.3rem; border-left: 1.25px solid var(--line-strong); }
    .bp-step a { display: grid; grid-template-columns: 6.25rem minmax(0, 1fr); align-items: baseline; gap: 0.75rem; padding: 0.7rem 0 0.7rem 2rem; text-align: left; }
    .bp-node, .is-high .bp-node { left: 6px; top: 1.3rem; }
  }
  @media (forced-colors: active) {
    .bp-motion, .bp-pulse { display: none; }
    .bp-sq { forced-color-adjust: none; border-color: CanvasText; background: Canvas; }
    .is-first .bp-sq { background: Highlight; border-color: Highlight; }
  }
</style>

