---
/**
 * Homepage signature: every lab (and the capstone) as a port on a rack patch
 * panel, numbered by lab ID. The plug and cable take the category's T568B
 * wire colour; the link LED reflects the simulator status in metadata.
 *
 * The panel is a visual index only (aria-hidden, ports out of the tab order).
 * The accessible equivalent is the port map list that follows it on the page.
 */
import { getRepository } from '../lib/content/repository';
import { wireFor } from '../lib/site';

interface Props { startId?: string }
const { startId } = Astro.props;
const repo = getRepository();
const byId = [...repo.labs].sort((a, b) => a.id.localeCompare(b.id, 'en', { numeric: true }));
const ports = [
  ...byId.map((lab) => {
    const w = wireFor(lab.category);
    return {
      key: lab.id,
      label: lab.id,
      href: lab.route,
      wire: `w-${w.color}${w.striped ? ' striped' : ''}`,
      led: lab.simulatorStatus === 'tested_pass' ? 'on' : lab.simulatorStatus === 'tested_fail' ? 'warn' : 'off',
      start: lab.id === startId,
    };
  }),
  ...repo.projects.map((p) => ({ key: p.slug, label: 'Capstone', href: p.route, wire: 'w-capstone', led: 'off', start: false })),
];
// Balanced rows, like a real patch panel: up to 16 ports in one row, otherwise
// split evenly (17 ports -> 9 + 8), so a new lab never leaves a lone port.
const cols = Math.ceil(ports.length / Math.ceil(ports.length / 16));
---
<div class="panel" aria-hidden="true">
  <span class="ear"><span class="slot"></span><span class="slot"></span></span>
  <ol class="ports" role="presentation" style={`--cols: ${cols}`}>
    {ports.map((p) => (
      <li class:list={['port', { start: p.start }]}>
        <a href={p.href} tabindex="-1">
          <span class:list={['tape', { 'tape-start': p.start }]}>{p.label}</span>
          <span class="jack">
            <span class="latch"></span>
            <span class:list={['plug', 'wire-fill', p.wire]}></span>
          </span>
          <span class="leds"><span class:list={['led', `led-${p.led}`]}></span><span class="led led-off"></span></span>
          <span class:list={['cable', 'wire-fill', p.wire]}></span>
        </a>
      </li>
    ))}
  </ol>
  <span class="ear"><span class="slot"></span><span class="slot"></span></span>
</div>

<style>
  .panel {
    display: flex;
    align-items: stretch;
    background: var(--c-steel);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px var(--c-panel-edge), inset 0 1px 0 var(--c-steel-line), inset 0 -2px 0 #15191d;
    overflow: hidden;
  }
  .ear {
    flex: 0 0 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
    border-inline: 1px solid #1a1e22;
  }
  .ear:first-child { border-left: 0; }
  .ear:last-child { border-right: 0; }
  .slot { width: 0.7rem; height: 1.1rem; border-radius: 0.35rem; background: #121519; }
  .ports {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: var(--sp-5) var(--sp-3) 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr));
    row-gap: var(--sp-2);
  }
  @media (min-width: 64rem) {
    .ports { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
  }
  .port a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    padding-bottom: 0;
  }
  .tape { font-size: 0.6875rem; padding: 0.2em 0.4em; }
  .tape-start { background: #ffffff; box-shadow: 0 0 0 2px var(--c-tape); }
  .jack {
    position: relative;
    width: 3.1rem;
    height: 2.6rem;
    margin-top: 0.35rem;
    background: var(--c-jack);
    border-radius: 3px;
    box-shadow: inset 0 0 0 2px #46505a;
  }
  .latch {
    position: absolute;
    left: 50%;
    top: -0.4rem;
    width: 1.25rem;
    height: 0.5rem;
    transform: translateX(-50%);
    background: var(--c-jack);
    box-shadow: inset 2px 2px 0 #46505a, inset -2px 0 0 #46505a;
  }
  .plug {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.4rem;
    height: 0.8rem;
    border-radius: 2px;
  }
  .leds { display: flex; gap: 0.4rem; }
  .led { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #3a424a; }
  .led-on { background: var(--c-led-on); box-shadow: 0 0 6px var(--c-led-on); }
  .led-warn { background: #f0a020; box-shadow: 0 0 6px #f0a020; }
  .cable { width: 0.85rem; height: 2.25rem; border-radius: 3px 3px 0 0; margin-top: 0.15rem; }
  .w-capstone { --w: #8a96a2; }
  .port:nth-child(3n + 2) .cable { height: 2.75rem; }
  .port:nth-child(3n) .cable { height: 1.9rem; }
  .port a:hover .jack { box-shadow: inset 0 0 0 2px var(--c-tape); }
  @media (max-width: 30rem) {
    .ear { flex-basis: 1.25rem; }
    .slot { width: 0.5rem; }
    .ports { padding-inline: var(--sp-1); grid-template-columns: repeat(auto-fill, minmax(3.7rem, 1fr)); }
    .jack { width: 2.7rem; height: 2.3rem; }
    .tape { font-size: 0.625rem; padding-inline: 0.3em; }
  }
  @media (forced-colors: active) {
    .panel { border: 1px solid CanvasText; }
  }
</style>
