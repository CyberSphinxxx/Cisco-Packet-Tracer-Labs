---
/**
 * The homepage search box. Typing shows matching labs in a panel under the
 * box, with a preview of the highlighted one; Enter opens it. With the panel
 * closed, Enter (or the "enter" key button) goes to the full search page with
 * the query in the address. Without JavaScript it is a plain GET form to /search/.
 */
import LabSearch from './LabSearch.astro';
---
<div class="hero-search">
  <LabSearch variant="hero" idPrefix="hero" />
</div>

<script>
  import { mountLabSearch } from '../scripts/lab-search.ts';
  const root = document.querySelector<HTMLElement>('.ls-hero[data-lab-search]');
  if (root) {
    const search = mountLabSearch(root, { limit: 8 });
    const { input } = search;
    const hasQuery = () => input.value.trim().length > 0;
    input.addEventListener('focus', () => {
      if (hasQuery()) {
        search.setOpen(true);
        search.refresh();
      }
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && search.isOpen()) {
        e.preventDefault();
        e.stopPropagation();
        search.setOpen(false);
        input.focus();
      }
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) search.setOpen(false);
    });
    document.addEventListener('pointerdown', (e) => {
      if (!root.contains(e.target as Node)) search.setOpen(false);
    });
  }
</script>

<style>
  .hero-search { max-width: 47rem; margin-top: 2.5rem; }
  @media (max-width: 40rem) {
    .hero-search { margin-top: 1.75rem; }
  }
</style>
