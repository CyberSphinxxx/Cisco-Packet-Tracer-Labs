---
/** Reference device configurations from configs/*.txt, viewable inline and downloadable. */
import type { ConfigFile } from '../lib/content/repository';
import { formatBytes } from '../lib/site';
interface Props { configs: ConfigFile[]; id?: string }
const { configs, id = 'site-config-files' } = Astro.props;
---
{configs.length > 0 && (
  <section class="configs prose" aria-labelledby={id}>
    <h2 id={id}>Reference configurations</h2>
    <p>Final device configurations from the solution. Like the solution file, these give the answers away.</p>
    {configs.map((c) => (
      <details class="config">
        <summary><span class="dev">{c.device}</span> <span class="meta">{c.name}, {formatBytes(c.bytes)}</span></summary>
        <div class="code-block"><button type="button" class="copy-code" hidden data-pagefind-ignore>Copy</button><pre tabindex="0"><code class="language-text">{c.content}</code></pre></div>
        <p class="config-dl"><a href={c.url} download>Download {c.name}</a></p>
      </details>
    ))}
  </section>
)}
<style>
  .configs h2 { margin-top: var(--sp-7); }
  .config { border: 1px solid var(--c-line); border-radius: var(--radius-md); background: var(--c-surface); }
  .config + .config { margin-top: var(--sp-2) !important; }
  .config summary { padding: var(--sp-3) var(--sp-4); cursor: pointer; display: list-item; min-height: 2.75rem; }
  .config .dev { font-weight: 700; font-family: var(--font-mono); }
  .config .meta { color: var(--c-muted); font-size: var(--fs-sm); margin-left: var(--sp-2); }
  .config .code-block { margin: 0 var(--sp-3); }
  .config-dl { margin: var(--sp-2) var(--sp-4) var(--sp-3) !important; font-size: var(--fs-sm); }
</style>
