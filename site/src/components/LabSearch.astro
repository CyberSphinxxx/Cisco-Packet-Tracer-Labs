---
/**
 * Terminal-style search box with a results list and a preview pane. Used by
 * the homepage hero (results float under the box while typing) and by the
 * header dialog (results always shown, suggestions before typing). Behaviour
 * lives in scripts/lab-search.ts; this file is markup and styles only.
 *
 * Without JavaScript the box is a plain GET form to the full search page.
 */
import { url } from '../lib/site';

interface Props {
  variant: 'hero' | 'dialog';
  /** Prefix for element ids (two instances can share a page). */
  idPrefix: string;
}
const { variant, idPrefix } = Astro.props;
const inputId = `${idPrefix}-q`;
const listId = `${idPrefix}-results`;
const heroInputAttr = variant === 'hero' ? { 'data-hero-input': '' } : {};
const heroPanelAttr = variant === 'hero' ? { 'data-hero-panel': '' } : {};
const heroResultsAttr = variant === 'hero' ? { 'data-hero-results': '' } : {};
const heroStatusAttr = variant === 'hero' ? { 'data-hero-status': '' } : {};
---
<div class={`ls ls-${variant}`} data-lab-search data-variant={variant} data-hero-search={variant === 'hero' ? '' : undefined}>
  <form class="ls-form" role="search" aria-label="Search the library" action={url('/search/')} method="get" data-search-form>
    <div class="ls-box">
      <span class="ls-prompt" aria-hidden="true">itn#</span>
      <label for={inputId} class="visually-hidden">Search labs, commands and guides</label>
      <input
        id={inputId}
        name="q"
        type="search"
        inputmode="search"
        enterkeyhint="search"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls={listId}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        maxlength="120"
        placeholder="search ospf, vlan, show ip route…"
        data-ls-input
        data-search-input
        {...heroInputAttr}
      />
      {variant === 'hero' ? (
        <button type="submit" class="ls-key"><span aria-hidden="true">enter ↵</span><span class="visually-hidden">Search</span></button>
      ) : (
        <button type="button" class="ls-key ls-close" data-search-close><span aria-hidden="true">esc</span><span class="visually-hidden">Close search</span></button>
      )}
    </div>
  </form>
  <div class="ls-panel" data-ls-panel {...heroPanelAttr} hidden={variant === 'hero'}>
    <div class="ls-col-list">
      <p class="ls-status" role="status" aria-live="polite" data-ls-status data-search-status {...heroStatusAttr}></p>
      <div class="ls-list" id={listId} role="listbox" aria-label="Search results" data-ls-list data-search-results {...heroResultsAttr}></div>
      <a class="ls-all" href={url('/search/')} data-ls-all>Open the full search page</a>
    </div>
    <div class="ls-preview" data-ls-preview></div>
  </div>
</div>

<style is:global>
  .ls { position: relative; text-align: left; }
  .ls-form { margin: 0; }
  .ls-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3.5rem;
    padding: 0 0.75rem 0 1.15rem;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-term);
    font-family: var(--font-mono);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .ls-hero .ls-box { box-shadow: var(--shadow-term); }
  .ls-hero .ls-box:focus-within { border-color: var(--focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 28%, transparent), var(--shadow-term); }
  .ls-prompt { flex: none; color: var(--tag-green); font-size: 0.9375rem; font-weight: 500; }
  .ls-box input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    outline: none;
  }
  .ls-box input::placeholder { color: var(--muted); opacity: 1; }
  .ls-key {
    flex: none;
    min-height: 2.25rem;
    padding: 0 0.6rem;
    border: 0;
    border-radius: var(--radius-tag);
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .ls-key:hover { color: var(--ink); background: var(--chip-active); }
  .ls-close span[aria-hidden] { padding: 0.1rem 0.4rem; border: 1px solid var(--line); border-radius: 4px; }

  /* Panel: list on the left, preview on the right. */
  .ls-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-term);
    overflow: hidden;
  }
  .ls-hero .ls-panel {
    position: absolute;
    z-index: 15;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    height: min(24rem, 64vh);
    box-shadow: var(--shadow-pop);
  }
  .ls-col-list { display: flex; flex-direction: column; min-height: 0; border-right: 1px solid var(--line); }
  .ls-status {
    margin: 0;
    padding: 0.9rem 1.1rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tag-green);
    font-weight: 500;
  }
  .ls-status:empty { display: none; }
  .ls-list { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 0.5rem 0.5rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .ls-opt {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.65rem 0.85rem;
    border-radius: 4px;
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .ls-opt:hover { background: color-mix(in srgb, var(--chip-active) 60%, transparent); }
  .ls-opt[aria-selected='true'] { background: var(--chip-active); }
  .ls-opt-title { font-size: 0.9375rem; font-weight: 600; line-height: 1.3; color: var(--ink); }
  .ls-opt-meta { font-size: 0.8125rem; color: var(--muted); }
  .ls-all {
    flex: none;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ls-all::after { content: ' →'; }
  .ls-all:hover { color: var(--ink); text-decoration: underline; }

  .ls-preview {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    min-height: 0;
    overflow-y: auto;
    padding: 1.6rem 1.75rem;
    background: var(--ls-preview-bg);
  }
  .ls-preview p { margin: 0; }
  .ls-pv-kicker { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tag-green); font-weight: 500; }
  .ls-pv-title { font-size: 1.625rem; font-weight: 700; line-height: 1.18; letter-spacing: -0.025em; color: var(--ink); text-wrap: balance; }
  .ls-pv-desc { font-size: 0.9375rem; line-height: 1.6; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .ls-pv-covers { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink); }
  .ls-pv-covers-label { text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .ls-pv-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.4rem; margin-top: 0.5rem; }
  .ls-pv-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 1.4rem;
    border-radius: 4px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition: opacity var(--dur) var(--ease);
  }
  .ls-pv-open:hover { opacity: 0.9; text-decoration: none; }
  .ls-pv-dl { font-size: 0.9375rem; color: var(--ink-2); text-decoration: none; }
  .ls-pv-dl:hover { color: var(--ink); text-decoration: underline; }

  /* Dialog: one frame, box on top, results always visible. */
  .ls-dialog .ls-box { height: 4.25rem; padding-left: 1.5rem; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; }
  .ls-dialog .ls-box input, .ls-dialog .ls-prompt { font-size: 1.0625rem; }
  .ls-dialog .ls-panel { height: min(34rem, calc(100dvh - 12rem)); border: 0; border-radius: 0; background: transparent; }

  @media (max-width: 48rem) {
    .ls-panel { grid-template-columns: minmax(0, 1fr); }
    .ls-preview { display: none; }
    .ls-col-list { border-right: 0; }
    .ls-hero .ls-panel { height: auto; max-height: min(24rem, 60vh); }
    .ls-dialog .ls-panel { height: calc(100dvh - 9rem); }
  }
  @media (forced-colors: active) {
    .ls-opt[aria-selected='true'] { outline: 2px solid Highlight; outline-offset: -2px; }
  }
</style>
